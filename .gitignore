# Entornos virtuales
.venv/
venv/
env/

# Cachés y archivos temporales
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
*.log

# Configuración local y secretos
.env
.env.*
!.env.example

# MLflow local
mlruns/
mlartifacts/

# Datos y artefactos pesados: se versionan con DVC o en Hugging Face Hub
# (data/raw y data/prepared los ignora data/.gitignore, generado por DVC)
models/
hf_build/
mlflow.db
*.csv
*.parquet
*.pkl
*.joblib
*.onnx

# Evidencias pequeñas que sí deben versionarse en Git
!evidencias/**/*.csv

# Registros de evidencia sí se versionan
!evidencias/**/*.log

# Archivos del sistema y editores
.DS_Store
.vscode/
.idea/

